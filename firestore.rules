rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    function appCheckValid() {
      return request.app != null
        && request.app.token != null;
    }

    function isAdminWithAppCheck() {
      return isAdmin() && appCheckValid();
    }

    // Shape guards — validate required top-level fields on create/update.
    // These are defence-in-depth; primary validation happens in server repos.

    function validClientShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'tags', 'status'])
          && d.name is string && d.name.size() > 0
          && d.status in ['active', 'archived'];
    }

    function validServiceShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['clientId', 'name', 'type', 'environment',
                              'criticality', 'currentStatus'])
          && d.name is string && d.name.size() > 0
          && d.environment in ['production', 'staging', 'dev']
          && d.criticality in ['low', 'medium', 'high', 'critical'];
    }

    function validIncidentShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['serviceId', 'clientId', 'state', 'severity',
                              'source', 'title'])
          && d.severity in ['minor', 'major', 'critical']
          && d.source in ['internal-check', 'manual'];
    }

    // ─── users/{uid} ────────────────────────────────────────────────────────
    // Admin can read/write any user doc; users can read only their own.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdminWithAppCheck();
    }

    // ─── Admin-only collections ──────────────────────────────────────────────
    // Reads require admin role only (auth + custom claim is sufficient for reads).
    // Writes and deletes additionally require a valid App Check token.
    match /clients/{docId} {
      allow read: if isAdmin();
      allow delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validClientShape();
      allow update: if isAdminWithAppCheck() && validClientShape();
    }
    match /services/{docId} {
      allow read: if isAdmin();
      allow delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validServiceShape();
      allow update: if isAdminWithAppCheck() && validServiceShape();
      match /daily/{day} {
        allow read: if isAdmin();
        allow write: if isAdminWithAppCheck();
      }
      match /timeline/{eventId} {
        allow read: if isAdmin();
        allow write: if isAdminWithAppCheck();
      }
    }
    match /incidents/{docId} {
      allow read: if isAdmin();
      allow delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validIncidentShape();
      allow update: if isAdminWithAppCheck() && validIncidentShape();
      match /timeline/{eventId} {
        allow read: if isAdmin();
        allow write: if isAdminWithAppCheck();
      }
    }
    match /tasks/{docId} {
      allow read: if isAdmin();
      allow write: if isAdminWithAppCheck();
    }
    match /alertDedup/{key} {
      // Alert deduplication — written by Cloud Functions (Admin SDK) only
      allow read, write: if false;
    }

    // ─── Quotes ─────────────────────────────────────────────────────────────
    // Writes use isAdminWithAppCheck().
    // create: only bozza status allowed from client SDK.
    // update: cannot touch an already-approved quote, nor approve from client SDK.
    //         (approveQuote server action uses Admin SDK, which bypasses rules.)
    match /quotes/{docId} {
      allow read: if isAdmin();
      allow create: if isAdminWithAppCheck()
          && request.resource.data.status == 'bozza';
      allow update: if isAdminWithAppCheck()
          && resource.data.status != 'approvato'
          && request.resource.data.status != 'approvato';
      allow delete: if isAdminWithAppCheck()
          && resource.data.status == 'bozza';
    }

    // ─── Payments ───────────────────────────────────────────────────────────
    // Created and mutated exclusively by server actions via Admin SDK.
    // Client SDK: read-only for admin, zero writes.
    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Counters ───────────────────────────────────────────────────────────
    // Atomic sequence counters. Managed exclusively by Admin SDK (runTransaction).
    match /counters/{year} {
      allow read, write: if false;
    }

    // ─── User settings subcollection ────────────────────────────────────────
    // Stores company info, PDF preferences, etc. at users/{uid}/settings/{docId}.
    // The existing /users/{uid} rule covers only the top-level doc.
    match /users/{uid}/settings/{docId} {
      allow read, write: if isAdminWithAppCheck() && request.auth.uid == uid;
    }

    // ─── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
