rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    function appCheckValid() {
      return request.app != null
        && request.app.token != null;
    }

    function isAdminWithAppCheck() {
      return isAdmin() && appCheckValid();
    }

    // Shape guards — validate required top-level fields on create/update.
    // These are defence-in-depth; primary validation happens in server repos.

    function validClientShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'businessType', 'contacts', 'supportPlan',
                              'consent', 'tags', 'status'])
          && d.name is string && d.name.size() > 0
          && d.status in ['active', 'paused', 'archived']
          && d.businessType in ['agency', 'ecommerce', 'corporate', 'startup', 'other']
          && d.supportPlan in ['none', 'monitor-only', 'reporting-only',
                               'managed-support', 'managed-infra', 'auto-healing'];
    }

    function validServiceShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['clientId', 'name', 'type', 'environment',
                              'criticality', 'currentStatus'])
          && d.name is string && d.name.size() > 0
          && d.environment in ['production', 'staging', 'dev']
          && d.criticality in ['low', 'medium', 'high', 'critical'];
    }

    function validMonitorShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['serviceId', 'clientId', 'source', 'config', 'active'])
          && d.source in ['uptimerobot', 'internal-http', 'internal-ssl',
                          'internal-dns', 'internal-domain']
          && d.active is bool;
    }

    function validIncidentShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['serviceId', 'clientId', 'state', 'severity',
                              'source', 'title'])
          && d.severity in ['minor', 'major', 'critical']
          && d.source in ['uptimerobot', 'internal-check', 'manual'];
    }

    // ─── users/{uid} ────────────────────────────────────────────────────────
    // Admin can read/write any user doc; users can read only their own.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdminWithAppCheck();
    }

    // ─── Admin-only collections ──────────────────────────────────────────────
    // All reads and writes require admin role + App Check token.
    // Create/update operations additionally validate document shape.
    match /clients/{docId} {
      allow read, delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validClientShape();
      allow update: if isAdminWithAppCheck() && validClientShape();
    }
    match /services/{docId} {
      allow read, delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validServiceShape();
      allow update: if isAdminWithAppCheck() && validServiceShape();
      match /daily/{day} {
        allow read, write: if isAdminWithAppCheck();
      }
      match /timeline/{eventId} {
        allow read, write: if isAdminWithAppCheck();
      }
    }
    match /resources/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /dependencies/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /monitors/{docId} {
      allow read, delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validMonitorShape();
      allow update: if isAdminWithAppCheck() && validMonitorShape();
    }
    match /incidents/{docId} {
      allow read, delete: if isAdminWithAppCheck();
      allow create: if isAdminWithAppCheck() && validIncidentShape();
      allow update: if isAdminWithAppCheck() && validIncidentShape();
      match /timeline/{eventId} {
        allow read, write: if isAdminWithAppCheck();
      }
    }
    match /maintenanceWindows/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /runbooks/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /tasks/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /reports/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /auditLog/{docId} {
      // Audit log is read-only even for admin via client SDK.
      // Writes happen only via Admin SDK (server-side), which bypasses rules.
      allow read: if isAdminWithAppCheck();
      allow write: if false;
    }
    match /statusTokens/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /secretRefs/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /webhookEvents/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /uptimeSamples/{docId} {
      allow read, write: if isAdminWithAppCheck();
    }
    match /webhookSecrets/{hash} {
      // Written only by Admin SDK (server-side); read by admin for management UI
      allow read: if isAdminWithAppCheck();
      allow write: if false;
    }
    match /processedEvents/{key} {
      // Idempotency records — written by webhook route via Admin SDK only
      allow read, write: if false;
    }
    match /alertDedup/{key} {
      // Alert deduplication — written by Cloud Functions (Admin SDK) only
      allow read, write: if false;
    }

    // ─── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
