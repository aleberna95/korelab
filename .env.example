# ─── Next.js app (alessiobernardini.dev / Vercel) ───────────────────────────

# Firebase JS SDK (browser) — safe to expose
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=korelab-cc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — server only, never exposed to the browser.
# Paste the full JSON content of your service account key as a SINGLE-LINE string.
# Generate via: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_ADMIN_SA_JSON=

# reCAPTCHA v3 site key — required for Firebase App Check on the browser SDK.
# Generate at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional — App Check debug token for local dev only (NEVER commit a real one).
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ─── Cloud Functions runtime (functions/.env or `firebase functions:config`) ─

# Your personal Telegram chat ID — receives admin alerts and weekly health checks.
# Find your chat ID by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_CHAT_ID=

# ─── Required Google Secret Manager secrets (do NOT put values here) ────────
# These must be created in your Firebase project's Secret Manager:
#
#   gcloud secrets create telegram-bot-token   --replication-policy="automatic"
#
# Then add a version with the actual value:
#   echo -n "VALUE" | gcloud secrets versions add SECRET_NAME --data-file=-
#
# Grant the Cloud Functions runtime service account read access:
#   gcloud secrets add-iam-policy-binding SECRET_NAME \
#     --member="serviceAccount:YOUR_PROJECT_ID@appspot.gserviceaccount.com" \
#     --role="roles/secretmanager.secretAccessor"


